      "get": {
        "summary": "Get all active court bookings within a date range for a specific parentclub",
        "operationId": "getActiveCourtBookingsInRange",
        "parameters": [
          {
            "name": "parentclub",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
